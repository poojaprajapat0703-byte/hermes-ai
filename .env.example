# =============================================================================
# Hermes — Environment Variables Example
# =============================================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit the actual .env file to git — it contains secrets.
# Add .env to your .gitignore.
#
# WHY ENVIRONMENT VARIABLES?
#   Hard-coding credentials in source code is a critical security risk.
#   If you ever push your code to GitHub with a DB password in a Python file,
#   that password is compromised forever (even if you delete it later).
#   Environment variables keep secrets out of your codebase.
#
# HOW PYTHON READS THESE:
#   import os
#   database_url = os.getenv("DATABASE_URL")
#
# HOW DOCKER COMPOSE READS THESE:
#   env_file: .env  ← in your docker-compose.yml service definition
# =============================================================================

# =============================================================================
# DATABASE
#
# Format: postgresql://username:password@host:port/database_name
#
# For local Docker Compose setup (your current stack):
#   - host = the docker-compose service name (e.g., "postgres")
#   - port = 5432 (Postgres default, inside the docker network)
#
# For testing (testcontainers sets this automatically in tests):
#   - testcontainers overrides this in the test fixture
#
# asyncpg uses this exact DSN format.
# =============================================================================
DATABASE_URL=postgresql://hermes:hermes_secret@localhost:5432/hermes_db

# For Docker Compose (service name as host):
# DATABASE_URL=postgresql://hermes_user:hermes_password@postgres:5432/hermes_db

# =============================================================================
# REDIS
# Format: redis://host:port/db_number
# db_number 0 = default database (redis has 16, 0-15)
# =============================================================================
REDIS_URL=redis://localhost:6379/0

# =============================================================================
# KAFKA
# =============================================================================
KAFKA_BOOTSTRAP_SERVERS=localhost:29092

# =============================================================================
# ANTHROPIC API (for AI analysis features)
# Get your key from: https://console.anthropic.com/
# =============================================================================
ANTHROPIC_API_KEY=your-api-key-here

# =============================================================================
# APPLICATION
# =============================================================================
APP_ENV=development        # development | staging | production
LOG_LEVEL=INFO             # DEBUG | INFO | WARNING | ERROR
SECRET_KEY=change-me-in-production   # Used for signing tokens

# =============================================================================
# HOW TO ADD THIS TO YOUR FASTAPI APP
#
# In your main.py or app startup:
#
#   from dotenv import load_dotenv
#   load_dotenv()  # Reads .env file and sets environment variables
#
# pip install python-dotenv
# =============================================================================
